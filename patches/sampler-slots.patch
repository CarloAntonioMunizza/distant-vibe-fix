@@ -0,0 +1,31 @@
+package com.gtnewhorizons.angelica.sdlgpu.sampler;
+
+import org.apache.logging.log4j.LogManager;
+import org.lwjgl.sdl.SDLVersion;
+
+/**
+ * Sampler slots per shader stage. Stock SDL GPU allows 16 and overflows its binding arrays past that,
+ * so 32 is used only with an SDL built with MAX_TEXTURE_SAMPLERS_PER_STAGE 32 and
+ * SDL_VENDOR_INFO=angelica-samplers32.
+ */
+public final class SamplerSlots {
+    private static int perStage;
+
+    private SamplerSlots() {}
+
+    public static int perStage() {
+        int slots = perStage;
+        if (slots == 0) {
+            final String revision = SDLVersion.SDL_GetRevision();
+            slots = revision != null && revision.contains("angelica-samplers32") ? 32 : 16;
+            perStage = slots;
+            LogManager.getLogger("Angelica-SDLGPU").info("Sampler slots per shader stage: {} (SDL revision: {})", slots, revision);
+        }
+        return slots;
+    }
+
+    /** GL_MAX_TEXTURE_IMAGE_UNITS: 17 with stock SDL, matching the unpatched backend. */
+    public static int textureUnits() {
+        return perStage() == 32 ? 32 : 17;
+    }
+}
